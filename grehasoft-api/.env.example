# WordPress API Base URL
WORDPRESS_BASE_URL=https://cms.grehasoft.com

# WordPress Throttling Controls
WORDPRESS_MAX_CONCURRENCY=1
WORDPRESS_REQUEST_DELAY_MS=100

# Cache TTL Configuration (Seconds)
CACHE_TTL_MENUS=600
CACHE_TTL_HOME=300
CACHE_TTL_SERVICES=600
CACHE_TTL_CLIENTS=600
CACHE_TTL_PORTFOLIO=300
CACHE_TTL_PORTFOLIO_CATEGORIES=600
CACHE_TTL_PROJECT_GALLERY=600
CACHE_TTL_BLOGS=300
CACHE_TTL_PAGES=600


# Server configuration
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Database Configuration (Placeholder - configure with local details)
DATABASE_ENABLED=false
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=grehasoft_db
